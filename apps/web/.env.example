# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/pullenv"

# next-auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# GitHub App credentials
GITHUB_APP_ID="123456"
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n..."
GITHUB_APP_CLIENT_ID="Iv1.xxxxxxxxxxxx"
GITHUB_APP_CLIENT_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
GITHUB_APP_WEBHOOK_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Master encryption key for wrapping per-repo DEKs (must be 32 bytes, base64-encoded)
# Generate with: openssl rand -base64 32
MASTER_ENCRYPTION_KEY="base64-encoded-32-byte-key"

# JWT signing secret for CLI tokens (must be at least 32 chars)
CLI_JWT_SECRET="change-me-in-production"
